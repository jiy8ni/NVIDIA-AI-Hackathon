# Offline is a deterministic, explicitly labelled test mode, not NVIDIA inference.
HANDOFF_MODEL_MODE=offline
HANDOFF_WORKFLOW_RUNTIME=native
HANDOFF_RETRIEVAL_MODE=fixture
# Leave blank for the local runner to generate ephemeral random secrets.
HANDOFF_INTERNAL_TOKEN=
HANDOFF_JWT_SECRET=
HANDOFF_USER_ID=kim-juhyung
HANDOFF_TEAM_ID=atlas
HANDOFF_ROLE=운영 담당자
# For actual inference: HANDOFF_MODEL_MODE=nemotron
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-nano-30b-a3b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Download the tokenizer matching the selected model yourself; no automatic downloads.
NVIDIA_TOKENIZER_PATH=
NVIDIA_CONTEXT_TOKENS=32768
# HTTP retrieval adapter sends query/sources/cursor/requestId/scope; see docs/data-contract.md.
HANDOFF_RETRIEVAL_URL=
HANDOFF_RETRIEVAL_TOKEN=
# Proposed ACL bridge; required before serving cached HTTP-retrieved content.
HANDOFF_ACCESS_URL=
# Optional: absolute Python path for the NAT environment.
HANDOFF_PYTHON=
