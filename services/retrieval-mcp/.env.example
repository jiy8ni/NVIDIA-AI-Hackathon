# NVIDIA NeMo Agent Toolkit
NVIDIA_API_KEY=
NVIDIA_MODEL=
RETRIEVAL_MCP_URL=http://127.0.0.1:8000/mcp

# Slack: user OAuth token with search:read.public/private and conversation history scopes.
SLACK_USER_TOKEN=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_OAUTH_REDIRECT_URI=http://localhost:3333/slack/callback

# Notion: share the pages and data sources with this Integration.
NOTION_TOKEN=
NOTION_VERSION=2026-03-11
NOTION_INDEX_MAX_PAGES=200
NOTION_INDEX_TTL_SECONDS=900
# Pages indexed in parallel (Notion allows ~3 requests/s; 429s are retried).
NOTION_INDEX_CONCURRENCY=4
# A search waits this long for the first index build, then answers from indexed pages as partial.
NOTION_INDEX_WAIT_SECONDS=5
# Comma-separated database names or IDs never indexed (e.g. a member directory with contact details).
NOTION_INDEX_EXCLUDE=
# Databases or pages (names or IDs) whose pages and sub-pages are indexed; empty = every shared page.
# Prefer an allowlist of the onboarding-relevant databases over indexing a whole workspace.
NOTION_INDEX_ROOTS=

# Google OAuth: use an access token directly, or provide refresh credentials.
GOOGLE_ACCESS_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_CORPORA=allDrives
