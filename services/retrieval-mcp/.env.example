# NVIDIA NeMo Agent Toolkit
NVIDIA_API_KEY=
NVIDIA_MODEL=
RETRIEVAL_MCP_URL=http://127.0.0.1:8000/mcp

# Slack: user OAuth token with search:read and conversation history scopes.
SLACK_USER_TOKEN=

# Notion: share the pages and data sources with this Integration.
NOTION_TOKEN=
NOTION_VERSION=2026-03-11
NOTION_INDEX_MAX_PAGES=200
NOTION_INDEX_TTL_SECONDS=900

# Google OAuth: use an access token directly, or provide refresh credentials.
GOOGLE_ACCESS_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_CORPORA=allDrives
